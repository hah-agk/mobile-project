<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8EEEC"
    tools:context=".LoginActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:scaleType="fitXY"
                android:src="@drawable/top_background1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Welcome\nBack"
                android:textColor="#FF8000"
                android:textSize="40sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTextTextemail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/edittext_background"
                android:drawableStart="@drawable/outline_mail_24"
                android:drawablePadding="10dp"
                android:ems="10"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="5dp"
                android:textColorHint="#756c6c"
                android:textColor="@color/black"/>

            <EditText
                android:id="@+id/editTextTextpassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/edittext_background"
                android:drawableStart="@drawable/outline_lock_24"
                android:drawablePadding="10dp"
                android:ems="10"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="5dp"
                android:textColorHint="#756c6c"
                android:textColor="@color/black"/>

            <ImageButton
                android:id="@+id/loginbutton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="end"
                android:layout_marginTop="20dp"
                android:layout_marginRight="40dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#FF8000"
                android:scaleType="centerCrop"
                android:src="@drawable/outline_arrow_forward_24"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp">

                <com.google.android.material.button.MaterialButton
                    style="@android:style/Widget.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="51dp"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/facebook_logo"
                    android:background="@drawable/btn_background"
                    app:backgroundTint="#F9D9C6"
                    android:text="Facebook"
                    android:textColor="#0078DC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="20dp"/>

                <com.google.android.material.button.MaterialButton
                    style="@android:style/Widget.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="51dp"
                    android:drawableEnd="@drawable/google_logo"
                    android:background="@drawable/btn_background"
                    app:backgroundTint="#F9D9C6"
                    android:paddingHorizontal="14dp"
                    android:layout_weight="1"
                    android:text="Google"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#E84235"/>
            </LinearLayout>

            <Button
                android:id="@+id/toregisteractivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                android:text="Are you new user? Register"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#9AFD7F00"
                android:layout_marginTop="13dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>